# aidata env template — copy to .env (mode 600, gitignored) and fill in.

# Fireworks extraction LLM key for the hindsight memory server; read by
# omp/extensions/hindsight.ts when it boots the server.
HINDSIGHT_API_LLM_API_KEY=

# omp's own model traffic (the default/review roles in omp/config.yml run
# fireworks/kimi-k3); also the fallback for the hindsight key above. omp
# auto-loads this .env for sessions launched in this repo; anywhere else it
# must come from your shell profile.
FIREWORKS_API_KEY=

# Optional: omp write-gate debug log to /tmp/gate-debug.log when 1.
OMP_GATE_DEBUG=0
